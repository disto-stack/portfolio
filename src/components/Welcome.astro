---
import Button from './shared/Button.astro';
---

<div class="min-h-screen flex flex-col bg-bg transition-colors duration-300">


	<div class="grow flex flex-col justify-center p-6 md:p-24 border-b-2 border-rule">
		<h1 class="flex flex-col">
			<span class="text-ink">JUAN MANUEL</span>
			<span class="text-accent outline-text" style="-webkit-text-stroke: 2px var(--rule);">OCAMPO.</span>
		</h1>
		
		<div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-12">
			<p class="max-w-xl">
				Especialista en Ingeniería de Software con enfoque en interfaces brutales y sistemas escalables. Este espacio utiliza <span class="text-accent font-bold">Tailwind v4</span> bajo una arquitectura de tokens estrictos.
			</p>
			
			<div class="flex flex-wrap gap-4 items-end justify-start md:justify-end">
				<Button text="Github" href="https://github.com" target="_blank" />
				<Button text="Linkedin" href="https://linkedin.com" target="_blank" />
				<Button text="X / Twitter" href="https://twitter.com" target="_blank" />
			</div>
		</div>
	</div>

	<div class="bg-accent p-4 overflow-hidden border-b-2 border-rule marquee-wrapper">
		<div class="flex whitespace-nowrap gap-12 animate-marquee">
			<span class="mono text-inv font-bold tracking-[3px]">AVAILABLE FOR SENIOR ROLES — 2026 — BASED IN LATAM — </span>
			<span class="mono text-inv font-bold tracking-[3px]">AVAILABLE FOR SENIOR ROLES — 2026 — BASED IN LATAM — </span>
			<span class="mono text-inv font-bold tracking-[3px]">AVAILABLE FOR SENIOR ROLES — 2026 — BASED IN LATAM — </span>
		</div>
	</div>
</div>

<style>
	.outline-text {
		color: var(--accent);
	}
	
	@keyframes marquee {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}

	.animate-marquee {
		display: inline-flex;
		animation: marquee 20s linear infinite;
	}

	.animate-marquee:hover {
		animation-play-state: paused;
	}
</style>
