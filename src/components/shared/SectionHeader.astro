---
interface Props {
	title: string;
	sectionNumber?: string;
}

const { title, sectionNumber } = Astro.props;

const formatSectionNumber = (sectionNumber?: string): string => {
	if (!sectionNumber) return '';
	return sectionNumber.padStart(3, '0');
};
---

<p class="mono text-xxs">{sectionNumber ? `${formatSectionNumber(sectionNumber)} / ` : ''} {title}</p>
